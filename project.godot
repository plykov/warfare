; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Garden Reclaimed"
config/version="0.7.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.015, 0.018, 0.015, 1)
boot_splash/image="res://assets/ariel-key-art.png"
config/icon="res://assets/ariel-key-art.png"

[autoload]

EventBus="*res://autoload/event_bus.gd"
SettingsState="*res://autoload/settings_state.gd"
GameState="*res://autoload/game_state.gd"
IntercessorSystem="*res://autoload/intercessor_system.gd"
MissionDirector="*res://autoload/mission_director.gd"
EncounterDirector="*res://autoload/encounter_director.gd"
RankSystem="*res://autoload/rank_system.gd"
CorruptionDirector="*res://autoload/corruption_director.gd"
PrideSystem="*res://autoload/pride_system.gd"
AudioDirector="*res://autoload/audio_director.gd"
DebugConsole="*res://autoload/debug_console.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

